; Engine configuration file.

config_version=5

[application]

config/name="Gambito Arruinado"
config/description="Roguelike de ajedrez con meta de puntos, reliquias, jefes y muchas explosiones."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Sfx="*res://scripts/sfx.gd"
Run="*res://scripts/run.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.105882, 0.0627451, 0.156863, 1)
